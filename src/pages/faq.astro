---
import BaseLayout from '../layouts/BaseLayout.astro';
const faqs = [['Is this site for console players?', 'No. Product information on this site is for PC only.'], ['Are third-party tools risk-free?', 'No. They may conflict with game or server rules and can lead to account action.'], ['Where can I find official game information?', 'Use the official 7 Days to Die site, Steam listing, and official support channels for current game facts.'], ['What about built-in commands?', 'Built-in console or debug options are different from third-party software and can depend on permissions and current game documentation.']];
---
<BaseLayout title="FAQ | 7 Days to Die Cheats" description="Answers to common PC product, server-rule, and game-information questions."><section class="pt-28 pb-20 md:pt-36"><div class="mx-auto max-w-3xl px-5"><p class="text-sm font-semibold uppercase tracking-[.2em] text-primary">PC information</p><h1 class="mt-3 font-[family-name:var(--font-heading)] text-5xl font-bold uppercase">Frequently asked questions</h1><div class="mt-8 space-y-4">{faqs.map(([question, answer]) => <details class="rounded-xl border border-border bg-card p-5"><summary class="cursor-pointer font-bold">{question}</summary><p class="mt-4 leading-7 text-muted-foreground">{answer}</p></details>)}</div></div></section></BaseLayout>
