---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { checkoutPath } from '../../../config/checkout';
const features = ['Visual settings', 'Overlay controls', 'Hotkeys', 'Config profiles'];
---
<BaseLayout title="7 Days to Die Cheats for PC | Product Features" description="Review 7 Days to Die PC product features, images, product notes, and checkout options." ogImage="/images/7dtd/visuals.webp">
  <section class="pt-28 pb-16 md:pt-36"><div class="mx-auto grid max-w-6xl gap-8 px-5 lg:grid-cols-[1.8fr_1fr]"><div><p class="text-sm font-semibold uppercase tracking-[.2em] text-primary">PC product</p><h1 class="mt-3 font-[family-name:var(--font-heading)] text-5xl font-bold uppercase">7 Days to Die Cheats</h1><p class="mt-5 max-w-2xl text-lg text-muted-foreground">Explore the listed product features and supplied interface previews. Availability and compatibility can change with game, Windows, or server updates.</p><img class="mt-8 aspect-video w-full rounded-2xl border border-border object-cover" src="/images/7dtd/visuals.webp" width="1200" height="675" alt="7 Days to Die visual configuration preview" /></div><aside class="h-fit rounded-2xl border border-primary/40 bg-card p-6 shadow-xl shadow-primary/10"><p class="text-sm font-semibold uppercase tracking-[.18em] text-primary">Product features</p><h2 class="mt-2 text-2xl font-bold">Explore what’s included</h2><ul class="mt-5 space-y-3 text-muted-foreground">{features.map((feature) => <li class="flex gap-2"><span class="text-primary">✓</span>{feature}</li>)}</ul><a class="mt-7 block rounded-lg bg-primary px-5 py-3 text-center font-semibold text-primary-foreground" href={checkoutPath('sevenDays')} rel="sponsored noopener nofollow">Proceed to Checkout →</a><p class="mt-4 text-xs leading-5 text-muted-foreground">Third-party software may violate server rules and can carry account risk. PC only.</p></aside></div></section>
</BaseLayout>
