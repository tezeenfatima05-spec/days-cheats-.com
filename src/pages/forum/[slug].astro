---
import BaseLayout from '../../layouts/BaseLayout.astro';
const topics: Record<string, string> = { 'server-rules-first':'Read a server’s published rules and moderation policy before connecting. Server owners set their own requirements.', 'pc-setup-checklist':'Keep Windows, drivers, and the game installation current; check official requirements before troubleshooting.', 'game-update-discussion':'Game updates can change gameplay and compatibility. Consult official patch notes for current details.', 'console-permissions':'Built-in commands and debugging functions depend on game mode, server permissions, and current documentation.', 'co-op-basics':'Coordinate with your group, respect host settings, and confirm the session’s rules before joining.', 'base-building-chat':'Use the game’s normal building systems and discuss strategies respectfully with your group.', 'trader-quest-tips':'Treat objectives and rewards as version-dependent; use in-game information and official notes for current mechanics.', 'world-generation':'World generation options and maps can vary by version and server configuration.', 'performance-settings':'Start with game video settings and published PC requirements before making system changes.', 'mod-server-etiquette':'Mods may have server-specific requirements. Ask the host and follow its published setup steps.', 'horde-night-planning':'Coordinate plans with your group and follow server rules for shared resources.', 'new-player-questions':'Use official guides and trusted community resources when learning the game.', 'controller-and-pc':'This site is PC-focused. Check official platform support for current input options.', 'dedicated-server-basics':'Review official server documentation and host instructions before changing a dedicated-server setup.', 'bug-report-resources':'Use the developer’s official support and reporting channels for reproducible game issues.', 'community-guidelines':'Keep discussion respectful, avoid personal data, and follow the rules of the community you join.', 'patch-notes-links':'Official patch notes are the source of truth for version-specific game changes.', 'safe-account-practices':'Use unique passwords, enable available account protections, and avoid sharing credentials.' };
export function getStaticPaths() { return ['server-rules-first', 'pc-setup-checklist', 'game-update-discussion', 'console-permissions', 'co-op-basics', 'base-building-chat', 'trader-quest-tips', 'world-generation', 'performance-settings', 'mod-server-etiquette', 'horde-night-planning', 'new-player-questions', 'controller-and-pc', 'dedicated-server-basics', 'bug-report-resources', 'community-guidelines', 'patch-notes-links', 'safe-account-practices'].map((slug) => ({ params: { slug } })); }
const title = topics[Astro.params.slug ?? 'new-player-questions'];
---
<BaseLayout title={`${title} | 7 Days to Die Forum`} description="Read-only 7 Days to Die community reference topic."><article class="pt-28 pb-20 md:pt-36"><div class="mx-auto max-w-3xl px-5"><a href="/forum/" class="text-sm text-primary">← Forum topics</a><p class="mt-8 text-sm font-semibold uppercase tracking-[.2em] text-primary">Read-only reference</p><h1 class="mt-3 font-[family-name:var(--font-heading)] text-5xl font-bold uppercase">{title}</h1><div class="mt-8 rounded-2xl border border-border bg-card p-7"><p class="leading-8 text-muted-foreground">{title}</p><p class="mt-6 text-sm text-muted-foreground">This is a static topic page and does not accept posts or show fabricated user activity.</p></div></div></article></BaseLayout>
