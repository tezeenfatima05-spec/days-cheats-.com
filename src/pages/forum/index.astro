---
import BaseLayout from '../../layouts/BaseLayout.astro';
const threads = [
  ['server-rules-first', 'Read server rules before joining'], ['pc-setup-checklist', 'PC setup checklist'], ['game-update-discussion', 'Game update discussion'], ['console-permissions', 'Console and admin permissions'], ['co-op-basics', 'Co-op basics'], ['base-building-chat', 'Base-building chat'], ['trader-quest-tips', 'Trader quest tips'], ['world-generation', 'World-generation discussion'], ['performance-settings', 'Performance-settings discussion'], ['mod-server-etiquette', 'Modded-server etiquette'], ['horde-night-planning', 'Horde-night planning'], ['new-player-questions', 'New player questions'], ['controller-and-pc', 'PC input discussion'], ['dedicated-server-basics', 'Dedicated server basics'], ['bug-report-resources', 'Bug-report resources'], ['community-guidelines', 'Community guidelines'], ['patch-notes-links', 'Patch notes and official links'], ['safe-account-practices', 'Safe account practices'],
];
---
<BaseLayout title="7 Days to Die Forum | Community Topics" description="Read-only community discussion topics for 7 Days to Die PC players."><section class="pt-28 pb-20 md:pt-36"><div class="mx-auto max-w-5xl px-5"><p class="text-sm font-semibold uppercase tracking-[.2em] text-primary">Read-only community</p><h1 class="mt-3 font-[family-name:var(--font-heading)] text-5xl font-bold uppercase">Forum</h1><p class="mt-4 max-w-2xl text-muted-foreground">A static reference board for player discussion topics. Posts are not submitted or attributed to real users.</p><div class="mt-9 divide-y divide-border overflow-hidden rounded-2xl border border-border bg-card">{threads.map(([slug, title], i) => <a href={`/forum/${slug}/`} class="flex items-center justify-between gap-4 p-5 transition hover:bg-muted/50"><div><h2 class="font-bold">{title}</h2><p class="mt-1 text-sm text-muted-foreground">Reference discussion · Read-only</p></div><span class="text-sm text-primary">Open →</span></a>)}</div></div></section></BaseLayout>
